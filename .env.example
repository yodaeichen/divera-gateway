# Langer Zufallswert, z. B. mit: openssl rand -base64 48
# Verschlüsselt die gespeicherten Zugangsdaten. Nach dem ersten Start nicht mehr ändern
# und sicher aufbewahren, sonst sind Accesskeys und Postfach-Zugänge nicht mehr lesbar.
SECRET_KEY=

# Erster Benutzer, wird nur beim allerersten Start angelegt (Passwort mindestens 12 Zeichen).
ADMIN_USER=admin
ADMIN_PASSWORD=

# true, wenn die Seite über HTTPS erreichbar ist (hinter dem Reverse Proxy). Nur für lokale Tests false.
COOKIE_SECURE=true

TZ=Europe/Berlin
# Nachrichten, die älter sind, lösen nichts mehr aus (Schutz nach Ausfällen).
MAX_AGE_MINUTES=15
# Aufbewahrung des Protokolls in Tagen.
LOG_DAYS=30
# DIVERA_API_URL=https://app.divera247.com/api/alarm
